{
  "format": "talas.project",
  "version": 35,
  "expressionLanguage": "variablesV2",
  "expressionDefinitions": [],
  "variableLibrary": { "version": 2, "variables": [] },
  "soundVariableLibrary": { "version": 1, "variables": [] },
  "generatorLibrary": { "version": 2, "programs": [] },
  "liveSetLibrary": { "version": 1, "liveSets": [], "tools": [] },
  "metadata": { "title": "Low-Pass Gate Control State Transport" },
  "presentation": {
    "version": 2,
    "structureLayouts": [
      {
        "scope": { "kind": "project" },
        "nodes": [
          { "nodeId": "source", "x": 40, "y": 180 },
          { "nodeId": "control", "x": 40, "y": 420 },
          { "nodeId": "gate", "x": 420, "y": 260 },
          { "nodeId": "out", "x": 760, "y": 260 }
        ]
      }
    ],
    "performanceControls": [],
    "performanceMeters": []
  },
  "snapshotLibrary": { "version": 1, "banks": [] },
  "sampleMapLibrary": { "version": 1, "maps": [] },
  "assets": [],
  "partialTrackEdits": [],
  "timeline": {
    "loop": { "enabled": false, "startSeconds": 0, "endSeconds": 2 },
    "musicalTime": {
      "ticksPerQuarter": 960,
      "tempo": [{ "tick": 0, "microsecondsPerQuarter": 500000 }],
      "meter": [{ "tick": 0, "numerator": 4, "denominator": 4 }]
    },
    "score": { "tracks": [], "clips": [], "automation": [], "markers": [] },
    "eventValues": []
  },
  "deviceSettings": {
    "configured": false,
    "audioInputDevice": "",
    "audioOutputDevice": "",
    "sampleRate": 0,
    "bufferSize": 0,
    "inputChannels": [],
    "outputChannels": [],
    "midiInputDevices": [],
    "transportSync": { "sourceMode": "internal", "sourceIdentifier": "" },
    "oscIngress": { "enabled": false, "port": 9000 },
    "oscEgress": { "enabled": false, "port": 9001 }
  },
  "soundDefinitions": [],
  "graph": {
    "nodes": [
      {
        "id": "source",
        "typeId": "talas.oscillator",
        "parameters": [
          { "id": "frequency", "expression": "1 hz" },
          { "id": "amplitude", "expression": "0.75" }
        ]
      },
      {
        "id": "control",
        "typeId": "talas.pulseTrain",
        "parameters": [
          { "id": "period", "expression": "1 s" },
          { "id": "variableDutyCycle", "boolean": true },
          { "id": "dutyCycle", "expression": "0.5" },
          { "id": "gate", "expression": "1" }
        ]
      },
      {
        "id": "gate",
        "typeId": "talas.lowPassGate",
        "parameters": [
          { "id": "control", "expression": "1 / 0" },
          { "id": "closedFrequency", "expression": "0.5 hz" },
          { "id": "openFrequency", "expression": "3 hz" },
          { "id": "attackTime", "expression": "0.25 s" },
          { "id": "releaseTime", "expression": "0.5 s" },
          { "id": "curve", "expression": "2" },
          { "id": "scale", "expression": "1" }
        ]
      },
      { "id": "out", "typeId": "talas.audioOutput", "parameters": [] }
    ],
    "connections": [
      { "fromNode": "source", "fromPort": "audioOut", "toNode": "gate", "toPort": "audioIn" },
      { "fromNode": "control", "fromPort": "value", "toNode": "gate", "toPort": "control" },
      { "fromNode": "gate", "fromPort": "audioOut", "toNode": "out", "toPort": "audioIn" }
    ]
  }
}
