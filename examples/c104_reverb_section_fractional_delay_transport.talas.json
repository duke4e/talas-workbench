          { "id": "prezero", "boolean": true },
          { "id": "interpolation", "choice": "linear" },
          { "id": "smoothDelayChanges", "boolean": false }
        ]
      },
      { "id": "out", "typeId": "talas.audioOutput", "parameters": [] }
    ],
    "connections": [
      { "fromNode": "source", "fromPort": "audioOut", "toNode": "reverb", "toPort": "audioIn" },
      { "fromNode": "delayScale", "fromPort": "value", "toNode": "reverb", "toPort": "delayScale" },
      { "fromNode": "reverb", "fromPort": "audioOut", "toNode": "out", "toPort": "audioIn" }
