    "version": 2,
    "structureLayouts": [
      {
        "scope": { "kind": "project" },
        "nodes": [
          { "nodeId": "source", "x": 40, "y": 180 },
          { "nodeId": "delayScale", "x": 40, "y": 420 },
          { "nodeId": "reverb", "x": 420, "y": 260 },
          { "nodeId": "out", "x": 760, "y": 260 }
        ]
      }
    ],
    "performanceControls": [],
    "performanceMeters": []
  },
  "snapshotLibrary": { "version": 1, "banks": [] },
  "sampleMapLibrary": { "version": 1, "maps": [] },
  "assets": [],
  "partialTrackEdits": [],
  "timeline": {
    "loop": { "enabled": false, "startSeconds": 0, "endSeconds": 2 },
    "musicalTime": {
      "ticksPerQuarter": 960,
      "tempo": [{ "tick": 0, "microsecondsPerQuarter": 500000 }],
      "meter": [{ "tick": 0, "numerator": 4, "denominator": 4 }]
    },
    "score": { "tracks": [], "clips": [], "automation": [], "markers": [] },
    "eventValues": []
  },
  "deviceSettings": {
    "configured": false,
    "audioInputDevice": "",
    "audioOutputDevice": "",
    "sampleRate": 0,
    "bufferSize": 0,
    "inputChannels": [],
    "outputChannels": [],
    "midiInputDevices": [],
