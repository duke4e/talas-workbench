    "oscIngress": { "enabled": false, "port": 9000 },
    "oscEgress": { "enabled": false, "port": 9001 }
  },
  "soundDefinitions": [],
  "graph": {
    "nodes": [
      {
        "id": "source",
        "typeId": "talas.oscillator",
        "parameters": [
          { "id": "frequency", "expression": "1 hz" },
          { "id": "amplitude", "expression": "0.75" }
        ]
      },
      {
        "id": "delayScale",
        "typeId": "talas.linearRamp",
        "parameters": [
          { "id": "duration", "expression": "1 s" },
          { "id": "start", "expression": "0.5" },
          { "id": "end", "expression": "1" }
        ]
      },
      {
        "id": "reverb",
        "typeId": "talas.reverbSection",
        "parameters": [
          { "id": "type", "choice": "allpass" },
          { "id": "scale", "expression": "0.75" },
          { "id": "decayTime", "expression": "0.5 s" },
          { "id": "delay", "expression": "0.375 s" },
