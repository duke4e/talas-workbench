          { "id": "formantImpulse", "resource": "" },
          { "id": "nbrImpulses", "expression": "2" },
          { "id": "allowFormantAtDC", "boolean": false }
        ]
      },
      {
        "id": "out",
        "typeId": "talas.audioOutput",
        "parameters": []
      }
