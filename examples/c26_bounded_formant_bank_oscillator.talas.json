        "toPort": "spectrum"
      },
      {
        "fromNode": "cascade",
        "fromPort": "audioOut",
        "toNode": "bank",
        "toPort": "cascadeInput"
      },
      {
        "fromNode": "bank",
        "fromPort": "audioOut",
        "toNode": "out",
        "toPort": "audioIn"
      }
    ]
