  "metadata": { "title": "Live Spectrum Modifier Selectors" },
  "presentation": {
    "version": 2,
    "structureLayouts": [
      {
        "scope": { "kind": "project" },
        "nodes": [
          { "nodeId": "spectrum", "x": 100, "y": 160 },
          { "nodeId": "selectControl", "x": 100, "y": 300 },
          { "nodeId": "hearAllControl", "x": 100, "y": 380 },
          { "nodeId": "modifier", "x": 360, "y": 220 },
          { "nodeId": "bank", "x": 600, "y": 220 },
          { "nodeId": "out", "x": 820, "y": 220 }
        ]
      }
    ],
    "performanceControls": [],
    "performanceMeters": []
  },
  "snapshotLibrary": { "version": 1, "banks": [] },
  "sampleMapLibrary": { "version": 1, "maps": [] },
  "assets": [],
  "partialTrackEdits": [],
  "timeline": {
    "loop": { "enabled": false, "startSeconds": 0, "endSeconds": 1 },
    "musicalTime": {
      "ticksPerQuarter": 960,
      "tempo": [{ "tick": 0, "microsecondsPerQuarter": 500000 }],
      "meter": [{ "tick": 0, "numerator": 4, "denominator": 4 }]
    },
    "score": { "tracks": [], "clips": [], "automation": [], "markers": [] },
    "eventValues": [
      { "timeSeconds": 0, "eventName": "C50Select", "domain": "scalar", "value": 1, "interpolation": "step" },
      { "timeSeconds": 0, "eventName": "C50HearAll", "domain": "scalar", "value": 1, "interpolation": "step" }
    ]
  },
  "deviceSettings": {
    "configured": false,
    "audioInputDevice": "",
    "audioOutputDevice": "",
    "sampleRate": 0,
    "bufferSize": 0,
    "inputChannels": [],
    "outputChannels": [],
    "midiInputDevices": [],
    "transportSync": { "sourceMode": "internal", "sourceIdentifier": "" },
    "oscIngress": { "enabled": false, "port": 9000 },
    "oscEgress": { "enabled": false, "port": 9001 }
  },
  "soundDefinitions": [],
  "graph": {
    "nodes": [
      {
        "id": "spectrum",
        "typeId": "talas.syntheticSpectrumFromArray",
        "parameters": [
          { "id": "nbrPartials", "expression": "4" },
          { "id": "logScale", "boolean": false },
          { "id": "sendBandwidths", "boolean": true },
          { "id": "envelope", "expression": "1" },
          { "id": "amplitudes", "text": "0.08 0.3 -0.12 0.16" },
          { "id": "frequencies", "text": "1 2 3 4" },
          { "id": "bandwidths", "text": "0 0 0 0" }
        ]
      },
      {
        "id": "selectControl",
        "typeId": "talas.constant",
        "parameters": [{ "id": "value", "expression": "!C50Select" }]
      },
      {
        "id": "hearAllControl",
        "typeId": "talas.constant",
        "parameters": [{ "id": "value", "expression": "!C50HearAll" }]
      },
      {
        "id": "modifier",
        "typeId": "talas.spectrumModifier",
        "parameters": [
          { "id": "select", "boolean": false },
          { "id": "loTrack", "expression": "2" },
          { "id": "hiTrack", "expression": "3" },
          { "id": "loFreq", "expression": "1.5 hz" },
          { "id": "hiFreq", "expression": "3.5 hz" },
          { "id": "freqHysteresis", "expression": "0 hz" },
          { "id": "freqScale", "expression": "0.5" },
          { "id": "freqOffset", "expression": "0.5" },
          { "id": "loAmp", "expression": "-1" },
          { "id": "hiAmp", "expression": "1" },
          { "id": "ampHysteresis", "expression": "0" },
          { "id": "ampScale", "expression": "0.75" },
          { "id": "ampOffset", "expression": "0" },
          { "id": "probability", "expression": "1" },
          { "id": "seed", "expression": "0" },
          { "id": "hearAll", "boolean": false }
        ]
      },
      {
        "id": "bank",
        "typeId": "talas.oscillatorBank",
        "parameters": [
          { "id": "nbrOscillators", "expression": "4" },
          { "id": "bankSize", "expression": "4096" },
          { "id": "wavetable", "resource": "" }
        ]
      },
      { "id": "out", "typeId": "talas.audioOutput", "parameters": [] }
    ],
    "connections": [
      { "fromNode": "spectrum", "fromPort": "spectrumOut", "toNode": "modifier", "toPort": "spectrumIn" },
      { "fromNode": "selectControl", "fromPort": "value", "toNode": "modifier", "toPort": "select" },
      { "fromNode": "hearAllControl", "fromPort": "value", "toNode": "modifier", "toPort": "hearAll" },
      { "fromNode": "modifier", "fromPort": "spectrumOut", "toNode": "bank", "toPort": "spectrum" },
      { "fromNode": "bank", "fromPort": "audioOut", "toNode": "out", "toPort": "audioIn" }
    ]
  }
