  "soundDefinitions": [],
  "graph": {
    "nodes": [
      {
        "id": "source",
        "typeId": "talas.oscillator",
        "parameters": [
          { "id": "frequency", "expression": "1 hz" },
          { "id": "amplitude", "expression": "1" }
        ]
      },
      {
